{
  "manifest_version": 3,
  "name": "ILM AI",
  "version": "1.0",
  "description": "Real-time Urdu subtitles for YouTube — bringing knowledge to Pakistani students",
"icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
},
"action": {
    "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
},
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.mymemory.translated.net/*",
    "https://code.responsivevoice.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ]
}